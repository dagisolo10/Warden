{
    "name": "warden",
    "version": "1.0.0",
    "description": "An Electron application with React and TypeScript",
    "main": "./out/main/index.js",
    "author": "example.com",
    "homepage": "https://electron-vite.org",
    "scripts": {
        "lint": "eslint --cache .",
        "format": "prettier --write .",
        "start": "electron-vite preview",
        "dev": "electron-vite dev --watch",
        "gen": "prisma generate",
        "st": "prisma studio",
        "reset": "prisma migrate reset",
        "seed": "electron ./out/main/seed.js",
        "typecheck": "bun run typecheck:node && bun run typecheck:web",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "build": "bun run typecheck && electron-vite build",
        "build:win": "bun run build && electron-builder --win",
        "build:unpack": "bun run build && electron-builder --dir",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux",
        "postinstall": "install-electron && electron-builder install-app-deps"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@prisma/adapter-libsql": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "cn": "^0.5.0",
        "electron-updater": "^6.8.9",
        "lucide-react": "^1.61.0",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-ts": "^4.0.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "dotenv": "^18.0.9",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "prettier": "^3.9.10",
        "prisma": "7.10.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.4"
    }
}
